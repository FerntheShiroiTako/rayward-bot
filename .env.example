# banbot is multi-server: everything below is process-wide, shared by every server the bot is in.
# Per-server settings (Rayward/Bloxlink API keys, mod role/channel, safety switches) are set by each
# server's own admins with /setup after the bot is invited and running - there is no GUILD_ID here.

# ---- Discord ----
DISCORD_TOKEN=
# Optional: a guild id to also instant-sync slash commands to during development (global sync can take
# up to ~1h to propagate to every server). Leave blank in production.
DEV_GUILD_ID=

# ---- Secrets at rest ----
# Encrypts every server's Rayward/Bloxlink API keys before they're written to SQLite. Generate one with:
#     python -m banbot.crypto
# Keep it secret and back it up - losing it means every server must run /setup again.
MASTER_KEY=

# ---- Rayward / Rotector / Bloxlink hosts (shared; per-server API keys are set with /setup) ----
RAYWARD_BASE_URL=https://roscoe.rayward.app
ROBLOX_BASE_URL=https://users.roblox.com
BLOXLINK_BASE_URL=https://api.blox.link
# One request per member (Bloxlink has no batch endpoint). 0.1 = about 10 lookups/second.
BLOXLINK_MIN_INTERVAL_S=0.1
# Bloxlink allows 2000 requests per day per server key. Each guild's sweep pauses at its own key's limit
# and continues after the UTC reset. RESERVE is held back from sweeps so member-join checks keep working.
BLOXLINK_DAILY_LIMIT=2000
BLOXLINK_DAILY_RESERVE=200

# ---- Batching / rate limits (shared by every server) ----
SWEEP_BATCH_SIZE=50
ROBLOX_BATCH_SIZE=100          # Roblox hard cap is 200
ROTECTOR_BATCH_SIZE=100        # Rotector hard cap is 100
ROBLOX_MIN_INTERVAL_S=1.0
ROTECTOR_MIN_INTERVAL_S=0.2
HTTP_TIMEOUT_S=15
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_S=2
HTTP_BACKOFF_MAX_S=60
SWEEP_CHUNK_DELAY_S=2
BAN_DELAY_S=1

# ---- Inconclusive retries ----
RETRY_MAX_RETRIES=5
RETRY_BASE_DELAY_S=30
RETRY_MAX_DELAY_S=900
RETRY_POLL_INTERVAL_S=30

# ---- Ban notice ----
# Default text DMed to a member right before they are banned, for servers that haven't set their own via
# /config. Placeholders: {server} {roblox_username} {roblox_id} {status}. Leave blank to send nothing by
# default (a server can still opt in with its own text via /config).
BAN_DM_FILE=ban_dm.txt

# ---- Storage ----
DB_PATH=data/banbot.sqlite3
RAW_RETENTION_HOURS=24
